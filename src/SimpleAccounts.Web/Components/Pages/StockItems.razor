@page "/stock-items"
@using Microsoft.EntityFrameworkCore
@using SimpleAccounts.Data
@using SimpleAccounts.Data.Models
@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation

<PageTitle>Stock Items - SimpleAccounts</PageTitle>

<h1>Stock Items</h1>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="ShowAddDialog">
        <i class="bi bi-plus"></i> Add New Stock Item
    </button>
</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Description</th>
            <th>Unit Price</th>
            <th>Quantity On Hand</th>
            <th>Warehouse Location</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in stockItems)
        {
            <tr>
                <td>@item.Code</td>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>@item.UnitPrice.ToString("C")</td>
                <td>@item.QuantityOnHand</td>
                <td>@item.WarehouseLocation</td>
                <td>
                    <button class="btn btn-sm btn-primary" @onclick="() => EditItem(item)">Edit</button>
                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteItem(item.Id)">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (showDialog)
{
    <div class="modal" tabindex="-1" style="display: block; background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editingItem?.Id > 0 ? "Edit" : "Add") Stock Item</h5>
                    <button type="button" class="btn-close" @onclick="CloseDialog"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Code</label>
                        <input type="text" class="form-control" @bind="editingItem!.Code" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" class="form-control" @bind="editingItem!.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" @bind="editingItem!.Description"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Unit Price</label>
                        <input type="number" step="0.01" class="form-control" @bind="editingItem!.UnitPrice" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Cost Price</label>
                        <input type="number" step="0.01" class="form-control" @bind="editingItem!.CostPrice" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Quantity On Hand</label>
                        <input type="number" class="form-control" @bind="editingItem!.QuantityOnHand" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Reorder Level</label>
                        <input type="number" class="form-control" @bind="editingItem!.ReorderLevel" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Warehouse Location</label>
                        <input type="text" class="form-control" @bind="editingItem!.WarehouseLocation" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDialog">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveItem">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<StockItem> stockItems = new();
    private bool showDialog = false;
    private StockItem? editingItem;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        stockItems = await DbContext.StockItems.ToListAsync();
    }

    private void ShowAddDialog()
    {
        editingItem = new StockItem();
        showDialog = true;
    }

    private void EditItem(StockItem item)
    {
        editingItem = new StockItem
        {
            Id = item.Id,
            Code = item.Code,
            Name = item.Name,
            Description = item.Description,
            UnitPrice = item.UnitPrice,
            CostPrice = item.CostPrice,
            QuantityOnHand = item.QuantityOnHand,
            ReorderLevel = item.ReorderLevel,
            WarehouseLocation = item.WarehouseLocation
        };
        showDialog = true;
    }

    private void CloseDialog()
    {
        showDialog = false;
        editingItem = null;
    }

    private async Task SaveItem()
    {
        if (editingItem != null)
        {
            if (editingItem.Id == 0)
            {
                editingItem.CreatedDate = DateTime.UtcNow;
                DbContext.StockItems.Add(editingItem);
            }
            else
            {
                var existing = await DbContext.StockItems.FindAsync(editingItem.Id);
                if (existing != null)
                {
                    existing.Code = editingItem.Code;
                    existing.Name = editingItem.Name;
                    existing.Description = editingItem.Description;
                    existing.UnitPrice = editingItem.UnitPrice;
                    existing.CostPrice = editingItem.CostPrice;
                    existing.QuantityOnHand = editingItem.QuantityOnHand;
                    existing.ReorderLevel = editingItem.ReorderLevel;
                    existing.WarehouseLocation = editingItem.WarehouseLocation;
                    existing.LastModifiedDate = DateTime.UtcNow;
                }
            }

            await DbContext.SaveChangesAsync();
            await LoadData();
            CloseDialog();
        }
    }

    private async Task DeleteItem(int id)
    {
        var item = await DbContext.StockItems.FindAsync(id);
        if (item != null)
        {
            DbContext.StockItems.Remove(item);
            await DbContext.SaveChangesAsync();
            await LoadData();
        }
    }
}
