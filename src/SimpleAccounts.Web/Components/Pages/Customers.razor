@page "/customers"
@using Microsoft.EntityFrameworkCore
@using SimpleAccounts.Data
@using SimpleAccounts.Data.Models
@inject ApplicationDbContext DbContext

<PageTitle>Customers - SimpleAccounts</PageTitle>

<h1>Customers</h1>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="ShowAddDialog">
        <i class="bi bi-plus"></i> Add New Customer
    </button>
</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>City</th>
            <th>Country</th>
            <th>Balance</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var customer in customers)
        {
            <tr>
                <td>@customer.Code</td>
                <td>@customer.Name</td>
                <td>@customer.Email</td>
                <td>@customer.Phone</td>
                <td>@customer.City</td>
                <td>@customer.Country</td>
                <td>@customer.Balance.ToString("C")</td>
                <td>
                    <button class="btn btn-sm btn-primary" @onclick="() => EditCustomer(customer)">Edit</button>
                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteCustomer(customer.Id)">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (showDialog)
{
    <div class="modal" tabindex="-1" style="display: block; background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editingCustomer?.Id > 0 ? "Edit" : "Add") Customer</h5>
                    <button type="button" class="btn-close" @onclick="CloseDialog"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Code</label>
                            <input type="text" class="form-control" @bind="editingCustomer!.Code" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Name</label>
                            <input type="text" class="form-control" @bind="editingCustomer!.Name" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" @bind="editingCustomer!.Email" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Phone</label>
                            <input type="text" class="form-control" @bind="editingCustomer!.Phone" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Address</label>
                        <input type="text" class="form-control" @bind="editingCustomer!.Address" />
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">City</label>
                            <input type="text" class="form-control" @bind="editingCustomer!.City" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">State/Region</label>
                            <input type="text" class="form-control" @bind="editingCustomer!.State" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Postal Code</label>
                            <input type="text" class="form-control" @bind="editingCustomer!.PostalCode" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Country</label>
                            <select class="form-select" @bind="editingCustomer!.Country">
                                <option value="">Select Country</option>
                                <option value="UK">United Kingdom</option>
                                <option value="USA">United States</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Credit Limit</label>
                            <input type="number" step="0.01" class="form-control" @bind="editingCustomer!.CreditLimit" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDialog">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveCustomer">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Customer> customers = new();
    private bool showDialog = false;
    private Customer? editingCustomer;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        customers = await DbContext.Customers.ToListAsync();
    }

    private void ShowAddDialog()
    {
        editingCustomer = new Customer();
        showDialog = true;
    }

    private void EditCustomer(Customer customer)
    {
        editingCustomer = new Customer
        {
            Id = customer.Id,
            Code = customer.Code,
            Name = customer.Name,
            Email = customer.Email,
            Phone = customer.Phone,
            Address = customer.Address,
            City = customer.City,
            State = customer.State,
            PostalCode = customer.PostalCode,
            Country = customer.Country,
            CreditLimit = customer.CreditLimit,
            Balance = customer.Balance
        };
        showDialog = true;
    }

    private void CloseDialog()
    {
        showDialog = false;
        editingCustomer = null;
    }

    private async Task SaveCustomer()
    {
        if (editingCustomer != null)
        {
            if (editingCustomer.Id == 0)
            {
                editingCustomer.CreatedDate = DateTime.UtcNow;
                DbContext.Customers.Add(editingCustomer);
            }
            else
            {
                var existing = await DbContext.Customers.FindAsync(editingCustomer.Id);
                if (existing != null)
                {
                    existing.Code = editingCustomer.Code;
                    existing.Name = editingCustomer.Name;
                    existing.Email = editingCustomer.Email;
                    existing.Phone = editingCustomer.Phone;
                    existing.Address = editingCustomer.Address;
                    existing.City = editingCustomer.City;
                    existing.State = editingCustomer.State;
                    existing.PostalCode = editingCustomer.PostalCode;
                    existing.Country = editingCustomer.Country;
                    existing.CreditLimit = editingCustomer.CreditLimit;
                    existing.Balance = editingCustomer.Balance;
                    existing.LastModifiedDate = DateTime.UtcNow;
                }
            }

            await DbContext.SaveChangesAsync();
            await LoadData();
            CloseDialog();
        }
    }

    private async Task DeleteCustomer(int id)
    {
        var customer = await DbContext.Customers.FindAsync(id);
        if (customer != null)
        {
            DbContext.Customers.Remove(customer);
            await DbContext.SaveChangesAsync();
            await LoadData();
        }
    }
}
