@page "/quotes"
@using Microsoft.EntityFrameworkCore
@using SimpleAccounts.Data
@using SimpleAccounts.Data.Models
@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation

<PageTitle>Quotes - SimpleAccounts</PageTitle>

<h1>Quotes</h1>

<div class="mb-3">
    <button class="btn btn-primary">
        <i class="bi bi-plus"></i> Create Quote
    </button>
</div>

@if (showSuccessMessage)
{
    <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Class="mb-3">
        Quote successfully converted to Sales Order #@convertedOrderNumber
    </MudAlert>
}

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Quote Number</th>
            <th>Customer</th>
            <th>Quote Date</th>
            <th>Expiry Date</th>
            <th>Status</th>
            <th>Total Amount</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var quote in quotes)
        {
            <tr>
                <td>@quote.QuoteNumber</td>
                <td>@quote.Customer?.Name</td>
                <td>@quote.QuoteDate.ToString("yyyy-MM-dd")</td>
                <td>@quote.ExpiryDate.ToString("yyyy-MM-dd")</td>
                <td><span class="badge bg-info">@quote.Status</span></td>
                <td>@quote.TotalAmount.ToString("C")</td>
                <td>
                    <button class="btn btn-sm btn-success" title="Generate PDF">
                        <i class="bi bi-file-pdf"></i> PDF
                    </button>
                    @if (quote.Status != "Accepted")
                    {
                        <button class="btn btn-sm btn-primary" @onclick="() => ConvertToSalesOrder(quote.Id)" title="Convert to Sales Order">
                            <i class="bi bi-arrow-right"></i> Convert
                        </button>
                    }
                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteQuote(quote.Id)">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<Quote> quotes = new();
    private bool showSuccessMessage = false;
    private string convertedOrderNumber = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        quotes = await DbContext.Quotes
            .Include(q => q.Customer)
            .OrderByDescending(q => q.QuoteDate)
            .ToListAsync();
    }

    private async Task ConvertToSalesOrder(int quoteId)
    {
        var quote = await DbContext.Quotes
            .Include(q => q.QuoteLines)
                .ThenInclude(ql => ql.StockItem)
            .FirstOrDefaultAsync(q => q.Id == quoteId);

        if (quote != null)
        {
            // Create sales order with unique order number
            var salesOrder = new SalesOrder
            {
                CustomerId = quote.CustomerId,
                OrderNumber = $"SO-{DateTime.UtcNow:yyyyMMddHHmmss}-{Guid.NewGuid():N}".Substring(0, 30),
                OrderDate = DateTime.UtcNow,
                Status = "Draft",
                SubTotal = quote.SubTotal,
                TaxAmount = quote.TaxAmount,
                TotalAmount = quote.TotalAmount,
                Notes = $"Converted from Quote #{quote.QuoteNumber}",
                CreatedDate = DateTime.UtcNow,
                OrderLines = new List<SalesOrderLine>()
            };

            foreach (var quoteLine in quote.QuoteLines)
            {
                salesOrder.OrderLines.Add(new SalesOrderLine
                {
                    StockItemId = quoteLine.StockItemId,
                    Quantity = quoteLine.Quantity,
                    UnitPrice = quoteLine.UnitPrice,
                    Discount = quoteLine.Discount,
                    LineTotal = quoteLine.LineTotal
                });
            }

            DbContext.SalesOrders.Add(salesOrder);

            // Update quote status
            quote.Status = "Accepted";
            quote.LastModifiedDate = DateTime.UtcNow;

            await DbContext.SaveChangesAsync();

            convertedOrderNumber = salesOrder.OrderNumber;
            showSuccessMessage = true;
            await LoadData();

            // Hide message after defined duration
            const int MESSAGE_DISPLAY_DURATION_MS = 5000;
            await Task.Delay(MESSAGE_DISPLAY_DURATION_MS);
            showSuccessMessage = false;
            StateHasChanged();
        }
    }

    private async Task DeleteQuote(int id)
    {
        var quote = await DbContext.Quotes.FindAsync(id);
        if (quote != null)
        {
            DbContext.Quotes.Remove(quote);
            await DbContext.SaveChangesAsync();
            await LoadData();
        }
    }
}
