@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using SimpleAccounts.Web.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <div class="d-flex align-items-center gap-3">
                        <span>Welcome, @context.User.FindFirst("FirstName")?.Value @context.User.FindFirst("LastName")?.Value</span>
                        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="Logout" Size="Size.Small">
                            <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" Class="me-1" /> Logout
                        </MudButton>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <a href="/login">Login</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", true);
    }
}
